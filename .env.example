# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Optional: absolute SQLite file and report directory overrides.
DB_FILE=
REPORTS_DIR=
# Optional production topology. DATABASE_URL selects Postgres and overrides DB_FILE.
DATABASE_URL=
REDIS_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_PREFIX=threatlens
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
RUN_SCHEDULER=true
RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
DEMO_MODE=true
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT=10
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BYTES=5242880
FEED_TIMEOUT_SECONDS=20
REQUIRE_MFA_FOR_ADMIN=false
# Used only when DEMO_MODE=false and the database has no users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional enrichment / feed credentials.
# Leave blank to use transparent local heuristics for synthetic demo data.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
THREATFOX_API_KEY=
GREYNOISE_API_KEY=

# HMAC secret for POST /api/v1/hooks/ingest (min 32 chars). Blank disables the hook.
WEBHOOK_SECRET=

# Optional outbound notification webhook for high severity alerts.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
